{
  "manifest_version": 3,
  "name": "操作手順書ジェネレーター",
  "version": "1.0.0",
  "description": "画面操作を自動でキャプチャし、スクリーンショット付きの操作手順書を生成。クリック・テキスト入力・ドロップダウン選択を記録して、HTML/PowerPoint形式でエクスポートできます。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
